# Videos y resultados generados
videos/*

# Conservar las carpetas principales de cada video
!videos/video1/
!videos/video2/
!videos/video3/

# Ignorar su contenido
videos/video1/*
videos/video2/*
videos/video3/*

# Conservar las carpetas mediante archivos vacíos
!videos/video1/.gitkeep
!videos/video2/.gitkeep
!videos/video3/.gitkeep

# Entorno virtual
fac_env311/

# Dependencia externa pesada
ProPainter/

# Archivos antiguos o temporales
cache/*
!cache/.gitkeep

# Python y Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Logs de SLURM
jobs/logs/
jobs/*.out
jobs/*.err
jobs/slurm-*.out
jobs/*-log.o*
jobs/*-err.o*

# Archivos temporales
*.tmp
*.temp